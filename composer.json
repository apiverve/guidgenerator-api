        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "guidgenerator",
        "guid",
        "guid generator",
        "globally unique identifier",
        "unique id",
        "identifier"
    ],
    "homepage": "https://apiverve.com/marketplace/guidgenerator?utm_source=php&utm_medium=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/guidgenerator",
        "source": "https://github.com/apiverve/guidgenerator-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
